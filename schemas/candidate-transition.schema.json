{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate-transition",
  "description": "Knowledge/proposal transport only. Runtime validation required; confers no authority. Integer-preserving parsing required.",
  "type": "object",
  "properties": {
    "lineage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "baseGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "baseCommitment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "value": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          }
        },
        "required": [
          "id",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "order": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615
      },
      "uniqueItems": true
    }
  },
  "required": [
    "lineage",
    "baseGeneration",
    "baseCommitment",
    "entries",
    "order"
  ],
  "additionalProperties": false
}
